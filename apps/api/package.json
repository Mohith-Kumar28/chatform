{
  "name": "@repo/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply chatform --local",
    "d1:migrate:remote": "wrangler d1 migrations apply chatform --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.2",
    "@better-auth/core": "^1.7.2",
    "@better-auth/utils": "0.4.2",
    "@hono/standard-validator": "^0.4.0",
    "@hono/zod-openapi": "^1.6.1",
    "@hono/zod-validator": "^0.9.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@repo/db": "workspace:*",
    "@repo/entitlements": "workspace:*",
    "@repo/form-schema": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "ai": "^7.0.77",
    "better-auth": "^1.7.2",
    "better-call": "1.4.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.0",
    "hono-openapi": "^1.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^4.20250810.0",
    "@repo/config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  }
}
