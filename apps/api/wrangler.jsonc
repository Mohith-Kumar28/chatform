{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The custom domain is declared here rather than clicked into the dashboard, so a fresh
  // account can reproduce the deployment from this file alone. Wrangler creates the DNS
  // record and the edge certificate on deploy; the workers.dev URL keeps working too.
  "routes": [{ "pattern": "api.chatform.in", "custom_domain": true }],
  // Declaring `routes` turns the workers.dev URL off by default. It has to stay on: the
  // Dodo webhook endpoint is registered at the workers.dev host, and a dead endpoint means
  // deliveries fail and subscriptions never activate.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatform",
      "database_id": "fa46b30f-26d4-4076-a7c3-d609401c3e15",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CONFIG",
      "id": "a72116dbd29c4e07b7d887272c1e999e"
    }
  ],
  // Cloudflare Email Service. The binding is the whole integration: no API key, no
  // secret to push, no outbound fetch subrequest. `EMAIL` is optional in `Bindings`
  // because Miniflare does not implement it — local dev logs the message instead of
  // sending, which is also what we want when developing against real customer data.
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "chatform-uploads"
    }
  ],
  // Workers AI carries the whole knowledge pipeline that is not a model call to
  // OpenRouter: `toMarkdown` turns an uploaded PDF, spreadsheet or image into
  // markdown, Whisper transcribes a voice note, and bge-m3 embeds the chunks.
  // The binding was already declared in `Bindings` and never bound; this is it.
  "ai": {
    "binding": "WORKERS_AI"
  },
  // One index for every form, partitioned by a per-form namespace rather than
  // an index each: Vectorize allows 50,000 namespaces per index and only 50,000
  // indexes per *account*, so a form-per-index design would spend the account's
  // entire ceiling on one customer's forms.
  //
  // `dimensions` and `metric` are immutable once the index exists. 1024 is
  // bge-m3's output and sits under Vectorize's 1536 ceiling; changing embedding
  // model later means a new index and a full re-embed, not an ALTER.
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "chatform-knowledge"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO"]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "Q_WEBHOOKS", "queue": "q-webhooks" },
      { "binding": "Q_EXPORTS", "queue": "q-exports" },
      { "binding": "Q_EMAIL", "queue": "q-emails" },
      { "binding": "Q_KNOWLEDGE", "queue": "q-knowledge" },
      { "binding": "Q_FEEDBACK", "queue": "q-feedback" }
    ],
    "consumers": [
      {
        // Bug reports, matched to issues one at a time. `max_concurrency: 1` is the
        // whole point: matching reads the open issues and then writes one, and two
        // reports of the same new bug handled in parallel would each find no issue
        // and open two — the duplication this queue exists to prevent. Serial, D1
        // reads its own writes and the race cannot happen. Its own queue so the
        // email queue keeps its parallelism for every other notification.
        "queue": "q-feedback",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_concurrency": 1,
        "max_retries": 3
      },
      {
        "queue": "q-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "q-webhooks-dlq"
      },
      {
        // Webhook messages that crashed the consumer ten times. HTTP failures
        // never land here (they retry on their own and end as `dead` rows);
        // this parks the crashes in the same failed list.
        "queue": "q-webhooks-dlq",
        "max_batch_size": 10,
        "max_retries": 3
      },
      {
        "queue": "q-exports",
        "max_batch_size": 1,
        "max_retries": 3
      },
      {
        // Batched, because one completed response can fan out to eleven messages
        // (ten notification addresses plus the auto-reply) and a batch of one
        // would be eleven invocations.
        "queue": "q-emails",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // A send that fails five times is not going to succeed on the sixth: the
        // usual causes are an unverified sender or a suppressed recipient, and
        // neither is transient. The DLQ is where those go to be looked at.
        "max_retries": 5,
        "dead_letter_queue": "q-emails-dlq"
      },
      {
        // One source per message. A batch would share a fate, and these
        // messages are long and uneven — a 40-page PDF next to a pasted
        // paragraph — so a batch is only as fast as its worst member and
        // retries the cheap ones along with the expensive one.
        "queue": "q-knowledge",
        "max_batch_size": 1,
        // Extraction is the failure-prone half and most of its failures are
        // permanent: a corrupt file, a page that will not parse, an image with
        // no text in it. Three attempts distinguishes a transient model error
        // from a document we are never going to read, and the row itself
        // records the reason either way.
        "max_retries": 3,
        "dead_letter_queue": "q-knowledge-dlq"
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "chatform_events"
    },
    // Separate from ANALYTICS on purpose: chatform_events already carries the
    // gate log's blob shape, and two shapes in one dataset make the SQL API
    // unusable.
    {
      "binding": "ANALYTICS_API",
      "dataset": "chatform_api_requests"
    }
  ],
  // Burst protection only. The `simple` config is per-binding and per-colo, so
  // per-plan limits come from a second binding rather than from logic: the plan
  // is not known until after the verification this layer exists to avoid.
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      // 10/s. A server integration writing a batch of responses legitimately
      // bursts well past two per second — the sustained per-key window on the
      // key row is where a customer-visible limit belongs, not here.
      "simple": {
        "limit": 100,
        "period": 10
      }
    },
    {
      "name": "RATE_LIMIT_PK",
      "namespace_id": "1002",
      // Browser traffic is one window per respondent on a page that may be busy.
      "simple": {
        "limit": 600,
        "period": 10
      }
    },
    // The respondent surface. Keyed by address, because `/p` has no key — and
    // split three ways because the three things a respondent can do cost wildly
    // different amounts, and one counter would have to be set for the dearest.
    {
      "name": "RATE_LIMIT_P",
      "namespace_id": "1003",
      // Everything under /p. Two a second sustained is far above a person
      // answering questions and far below anything worth calling traffic.
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_P_START",
      "namespace_id": "1004",
      // Opening a session writes rows and meters a response. Eight a minute
      // covers a reload, a start-over, an embed and the hosted page at once;
      // nothing legitimate needs a ninth.
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_P_AUTH",
      "namespace_id": "1005",
      // Each attempt fetches a JWKS document over the network before it can
      // fail, so this is the one an attacker would pick.
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      // Asset uploads, keyed by author. Generous, because a builder session
      // legitimately adds a handful of images in a row and each one is a
      // separate request; low enough that a loop cannot fill a bucket.
      "name": "RATE_LIMIT_ASSET",
      "namespace_id": "1007",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_SAVE",
      "namespace_id": "1006",
      // The builder's autosave, keyed by author. The editor checkpoints at most
      // every ten seconds per tab, so someone with five forms open still sits at
      // a quarter of this — it bounds a client stuck in a loop, not a person
      // working. `period` may only be 10 or 60; a minute is the useful one here.
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  // The running deploy's id, tagged onto every AI call as `trace.release` (see `lib/ai.ts`
  // `telemetry`). A binding rather than a var because only Cloudflare knows the value.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // No `vars` block on purpose. Every value the worker reads — ENVIRONMENT, APP_ORIGIN,
  // WEB_ORIGINS and the secrets — lives in apps/api/.prod.vars and is uploaded with
  // `pnpm secrets:push`. Splitting configuration between this file and a secret store is
  // how the two drift apart; one file cannot disagree with itself.
}
