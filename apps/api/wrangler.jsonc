{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatform-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // The custom domain is declared here rather than clicked into the dashboard, so a fresh
  // account can reproduce the deployment from this file alone. Wrangler creates the DNS
  // record and the edge certificate on deploy; the workers.dev URL keeps working too.
  "routes": [{ "pattern": "api.chatform.in", "custom_domain": true }],
  // Declaring `routes` turns the workers.dev URL off by default. It has to stay on: the
  // Dodo webhook endpoint is registered at the workers.dev host, and a dead endpoint means
  // deliveries fail and subscriptions never activate.
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chatform",
      "database_id": "fa46b30f-26d4-4076-a7c3-d609401c3e15",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CONFIG",
      "id": "a72116dbd29c4e07b7d887272c1e999e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "chatform-uploads"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_DO",
        "class_name": "SessionDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionDO"]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "Q_SUBMISSIONS", "queue": "q-submissions" },
      { "binding": "Q_WEBHOOKS", "queue": "q-webhooks" },
      { "binding": "Q_EXPORTS", "queue": "q-exports" }
    ],
    "consumers": [
      {
        "queue": "q-submissions",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "q-submissions-dlq"
      },
      {
        "queue": "q-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "q-webhooks-dlq"
      },
      {
        "queue": "q-exports",
        "max_batch_size": 1,
        "max_retries": 3
      }
    ]
  },
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "chatform_events"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 10
      }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // No `vars` block on purpose. Every value the worker reads — ENVIRONMENT, APP_ORIGIN,
  // WEB_ORIGINS and the secrets — lives in apps/api/.prod.vars and is uploaded with
  // `pnpm secrets:push`. Splitting configuration between this file and a secret store is
  // how the two drift apart; one file cannot disagree with itself.
}
