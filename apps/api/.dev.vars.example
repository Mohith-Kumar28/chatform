# Copy to .dev.vars and fill in. .dev.vars is gitignored; this file is not.
#
# LOCAL DEVELOPMENT ONLY. `wrangler dev` reads .dev.vars; nothing here is ever deployed,
# which is why the origins below point at localhost and should stay that way.
#
# The deployed worker's configuration is the same set of keys with production origins, in
# apps/api/.prod.vars — see .prod.vars.example. Upload it with `pnpm secrets:push`.

BETTER_AUTH_SECRET=at-least-32-characters-of-random-text
SIGNING_SALT=any-random-string

# This API's own public origin — Better Auth uses it as its baseURL.
APP_ORIGIN=http://localhost:8787
# Where the browser app lives. Everything a customer is redirected back to (post-checkout
# return, cancel, the billing portal's back link) uses this, NOT APP_ORIGIN. They are only
# the same value while the API and the web app share a host. Falls back to APP_ORIGIN.
WEB_ORIGIN=http://localhost:3000

# ── AI ────────────────────────────────────────────────────────────────────────
# Absent: /api/ai/* returns 503 and interviews run in deterministic template mode.
OPENROUTER_API_KEY=

# ── Billing (Dodo Payments) ───────────────────────────────────────────────────
# "test" or "live". Absent means test — a missing value must never charge a real card.
DODO_ENVIRONMENT=test
# Dashboard → Developer → API Keys. Absent: checkout and the portal return 503.
DODO_API_KEY=
# Dashboard → Developer → Webhooks, per endpoint. Absent: subscriptions never activate,
# because every delivery is rejected as misconfigured rather than accepted unverified.
DODO_WEBHOOK_SECRET=
#
# Set DODO_API_KEY above, then run this once — it creates the products, the collection and
# the webhook, reads the signing key back into this file, and links every product id:
#
#   pnpm dodo:provision -- --webhook-url https://api.chatform.in \
#                          --remote --push-secrets
#
# Confirm with GET /api/billing/config-check as an owner.

# ── Email ─────────────────────────────────────────────────────────────────────
# Sending goes through the Cloudflare Email Service binding (`send_email` in
# wrangler.jsonc) — no key, nothing to push. What IS required is onboarding the
# sending domain once, in the dashboard under Compute > Email Service > Email
# Sending; Cloudflare writes the MX, SPF, DKIM and DMARC records itself. Until
# that is done every send fails E_SENDER_NOT_VERIFIED.
#
# Unset locally on purpose: Miniflare does not implement the binding, so dev logs
# `mail_not_configured` with the recipient and subject instead of sending. That is
# the behaviour you want while developing against real customer data.
#
# EMAIL_FROM defaults to `chatform <noreply@<apex of APP_ORIGIN>>`.
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Optional ──────────────────────────────────────────────────────────────────
# The fallback sender. Email Sending is in public beta on a daily quota that
# Cloudflare scales with reputation and does not publish; set this and the binding
# is bypassed for Resend's HTTP API, with no other change. See lib/mail.ts.
RESEND_API_KEY=

# The From address for follow-up reminders, which always go over Resend and
# never touch the binding. Set this whenever RESEND_API_KEY is set: unset, it
# derives `hello@mail.<apex of APP_ORIGIN>`, and the local APP_ORIGIN is
# localhost — so the sender becomes `hello@mail.localhost` and Resend rejects
# every reminder. Marketing mail has no fallback transport to absorb that.
#
# Whatever you put here must be a domain verified in Resend, which means a
# reminder sent from a dev worker is a real email. Use a Resend test address if
# that is not what you want.
EMAIL_FROM_MARKETING=

TURNSTILE_SECRET_KEY=
FILE_ENCRYPTION_KEY=

# ── Google sign-in ────────────────────────────────────────────────────────────
# There are TWO separate Google clients, and they must not be the same one:
#
#   GOOGLE_RESPONDENT_CLIENT_ID   people answering a public form  (/f/<slug>)
#   GOOGLE_DASHBOARD_CLIENT_ID    you and your team signing in    (/signin)
#   GOOGLE_DASHBOARD_CLIENT_SECRET
#
# Why two: the respondent check accepts any Google ID token whose `aud` equals the
# respondent client id. Share one client and a token minted for a dashboard sign-in would
# also pass as a respondent identity on every form gated on Google.
#
# Both live in the SAME Google Cloud project. Create the project once at
# https://console.cloud.google.com/projectcreate, then configure the consent screen once —
# APIs & Services → OAuth consent screen → External → app name, your support email,
# developer email → Save. Add yourself under "Test users" while it is unpublished, or only
# accounts you list can sign in.
#
# ── 1. Respondent client (public forms) ───────────────────────────────────────
# APIs & Services → Credentials → + Create credentials → OAuth client ID
#   Application type:              Web application
#   Name:                          chatform-respondent
#   Authorized JavaScript origins: (the origin the FORM PAGE is served from — the web app,
#                                   not this API)
#                                  https://<your-web-app-domain>
#                                  http://localhost:3000        ← add for local testing
#   Authorized redirect URIs:      none. Google Identity Services is a browser-only flow
#                                  and never redirects back to us.
# Create → copy "Client ID". There is no secret to copy, and it is not one — the browser
# ships it. Put the same value in apps/web/.env.local as
# NEXT_PUBLIC_GOOGLE_RESPONDENT_CLIENT_ID, or the button never renders.
GOOGLE_RESPONDENT_CLIENT_ID=

# ── 2. Dashboard client (team sign-in) ────────────────────────────────────────
# Unset: the sign-in page shows email and password only. Both set: it also shows
# "Continue with Google". A client id with no secret cannot complete the code exchange, so
# half a pair is treated as unset rather than as enabled.
#
# APIs & Services → Credentials → + Create credentials → OAuth client ID
#   Application type:              Web application
#   Name:                          chatform-dashboard
#   Authorized JavaScript origins: none needed
#   Authorized redirect URIs:      https://api.chatform.in/api/auth/callback/google
#                                  http://localhost:8787/api/auth/callback/google   ← add for local testing
# Create → copy "Client ID" and "Client secret" (the secret is shown once; reopen the
# client to copy it again).
#
# The redirect URI is on the API origin, NOT the web app's — Better Auth handles the
# callback and APP_ORIGIN is its baseURL. If you ever change APP_ORIGIN, this URI has to
# change with it, or Google returns redirect_uri_mismatch.
#
# For the deployed worker these are secrets, not vars — do not put them in wrangler.jsonc:
#   pnpm --filter @repo/api exec wrangler secret put GOOGLE_RESPONDENT_CLIENT_ID
#   pnpm --filter @repo/api exec wrangler secret put GOOGLE_DASHBOARD_CLIENT_ID
#   pnpm --filter @repo/api exec wrangler secret put GOOGLE_DASHBOARD_CLIENT_SECRET
GOOGLE_DASHBOARD_CLIENT_ID=
GOOGLE_DASHBOARD_CLIENT_SECRET=

# ── Phone sign-in, hosted form (Firebase) ─────────────────────────────────────
# Firebase sends and checks the SMS, so there is no number to rent and no Indian
# DLT registration to complete. This worker only verifies the ID token that comes
# back, so the project id is the whole server-side configuration — there is no
# service-account key to store here.
#
# The browser needs the matching NEXT_PUBLIC_FIREBASE_* values in apps/web, and
# the Firebase console must list the form's domain under
# Authentication → Settings → Authorized domains.
#
# Unset in dev: the form falls back to the server OTP below, which prints the
# code instead of sending it. That is the intended local setup — running the
# form does not require a Firebase project.
FIREBASE_PROJECT_ID=

# ── Phone sign-in, headless /v1 (Twilio) ──────────────────────────────────────
# Only for /v1 callers, who drive the conversation from their own server and so
# cannot run Firebase's browser reCAPTCHA. The hosted form does not use this.
# Absent in dev: phone OTP codes are logged instead of sent. Absent in
# production: the server OTP path fails closed rather than handing out codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
