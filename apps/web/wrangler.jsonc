{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatform-web",
  // Built by `opennextjs-cloudflare build`, not by wrangler — deploying without that
  // build step first ships whatever the last build left behind.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  // Both are required by OpenNext: Next's server code reaches for node builtins, and
  // `nodejs_compat_populate_process_env` is what makes `process.env` readable at runtime.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Apex domain. `www` is deliberately not a second custom domain — one canonical host
  // keeps the session cookie, the OAuth origins and the CORS allow-list to a single value.
  "routes": [{ "pattern": "chatform.in", "custom_domain": true }],
  // Kept on as a fallback host while DNS and certificates settle.
  "workers_dev": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
