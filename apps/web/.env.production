# Loaded by `next build`. Everything here is baked into the client bundle, so nothing
# secret may go in this file — it is committed on purpose (see .gitignore's !.env.production)
# so that a build from a clean checkout points at production rather than at localhost.
NEXT_PUBLIC_API_ORIGIN=https://api.chatform.in
API_ORIGIN=https://api.chatform.in

# Public by design: the browser ships this to Google to render the respondent sign-in
# button. The matching secret-free client is "chatform-respondent" in Google Cloud.
NEXT_PUBLIC_GOOGLE_RESPONDENT_CLIENT_ID=210060928500-6f6fh5otbi4e4jr7npkb6ds47jl23f9s.apps.googleusercontent.com

# The canonical host, used by sitemap.ts and robots.ts. Without it they advertise
# a fallback domain, which is worse than emitting nothing.
NEXT_PUBLIC_SITE_ORIGIN=https://chatform.in

# Firebase phone sign-in for respondents. Public by design — these identify the
# project, they do not authorize anything; what keeps other sites out is the
# Authorized domains list in Authentication → Settings, which must include
# chatform.in. Copy the three values from Firebase console → Project settings →
# General → Your apps → the Web app's SDK snippet, and set FIREBASE_PROJECT_ID
# on the API worker to the same project.
#
# Left blank the form falls back to the API's own SMS OTP, which needs Twilio
# configured to reach anyone — so until these are filled in, phone verification
# on a live form fails with "We couldn't send that code."
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBDWv4GwsDnRfS6lf3kB9Yr29usW3k3aj0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=chatform-bc595.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=chatform-bc595

# "See plans" point here, in a new tab. Published from the Dodo dashboard
