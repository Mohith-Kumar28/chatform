:false,"kind":"success","requirements":[]},{"id":"end_boardgam04","ref":"end_heavy","title":"Heavy strategy games 🧠","bodyMd":"Your group wants decisions that pay off an hour later. Terraforming Mars and Brass: Birmingham reward planning and repeat plays, so set aside a full evening for the first game.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]},{"id":"end_boardgam05","ref":"end_duo","title":"Two-player games ⚔️","bodyMd":"Games designed for two are tighter than big games played with two. 7 Wonders Duel, Patchwork and Jaipur each play in under an hour and stay tense to the end.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_boardgam01","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"evening"},"op":"eq","value":"opt_loud_silly_and"}],"groups":[]},"from":"evening","target":"end_party","targetKind":"ending","branch":"true"},{"id":"rl_boardgam02","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"evening"},"op":"eq","value":"opt_working_together_to"}],"groups":[]},"from":"evening","target":"end_coop","targetKind":"ending","branch":"true"},{"id":"rl_boardgam03","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"evening"},"op":"eq","value":"opt_a_deep_thinky"}],"groups":[]},"from":"evening","target":"end_heavy","targetKind":"ending","branch":"true"},{"id":"rl_boardgam04","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"players"},"op":"eq","value":"opt_just_two"}],"groups":[]},"from":"players","target":"duo_style","targetKind":"block","branch":"true"},{"id":"rl_boardgam05","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"players"},"op":"eq","value":"opt_three_or_four"}],"groups":[]},"from":"players","target":"evening","targetKind":"block","branch":"true"},{"id":"rl_boardgam06",