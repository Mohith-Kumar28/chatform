"Dice deciding who wins","image_key":null},{"id":"opt_lots_of_reading","label":"Lots of reading","image_key":null},{"id":"opt_long_setup","label":"Long setup","image_key":null}],"minSelections":0,"maxSelections":5,"allowOther":false},{"id":"blk_boardgam05","ref":"themes","title":"Which themes sound fun?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_fantasy_and_adventure","label":"Fantasy and adventure","image_key":null},{"id":"opt_space_and_science","label":"Space and science fiction","image_key":null},{"id":"opt_nature_and_animals","label":"Nature and animals","image_key":null},{"id":"opt_trains_trade_and","label":"Trains, trade and building","image_key":null},{"id":"opt_mystery_and_deduction","label":"Mystery and deduction","image_key":null},{"id":"opt_no_preference","label":"No preference","image_key":null}],"minSelections":0,"maxSelections":6,"allowOther":false},{"id":"blk_boardgam06","ref":"favourite","title":"Name a game your group already loves, if you have one.","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"short_text","unique":false,"minLength":0,"maxLength":120},{"id":"blk_boardgam07","ref":"email","title":"Want us to send your recommendations?","description":"Optional.","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"email","unique":false,"businessOnly":false,"allowedDomains":[],"verify":false},{"id":"blk_boardgam08","ref":"players","title":"Nearly done. How many people usually play?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_just_two","label":"Just two","image_key":null},{"id":"opt_three_or_four","label":"Three or four","image_key":null},{"id":"opt_five_or_six","label":"Five or six","image_key":null},{"id":"opt_seven_or_more","label":"Seven or more","image_key":null}],"allowOther":false},{"id":"blk_board