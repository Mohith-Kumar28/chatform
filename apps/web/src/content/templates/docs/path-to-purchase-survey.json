quality","label":"Quality"},{"id":"opt_item_reviews","label":"Reviews"},{"id":"opt_item_delivery_speed","label":"Delivery speed"},{"id":"opt_item_trust_in","label":"Trust in the brand"},{"id":"opt_item_returns_policy","label":"Returns policy"}]},{"id":"blk_pathto09","ref":"where_bought","title":"Where did you complete the purchase?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_our_website","label":"Our website","image_key":null},{"id":"opt_our_app","label":"Our app","image_key":null},{"id":"opt_in_a_shop","label":"In a shop","image_key":null},{"id":"opt_an_online_marketplace","label":"An online marketplace","image_key":null},{"id":"opt_by_phone","label":"By phone","image_key":null}],"allowOther":false},{"id":"blk_pathto10","ref":"info_ease","title":"How easy was it to find the information you needed to decide?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"opinion_scale","steps":5,"startAt":1,"labelLow":"Very hard","labelHigh":"Very easy"},{"id":"blk_pathto11","ref":"hesitation","title":"Was anything close to stopping you from buying?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":800,"aiQualityCheck":false}],"endings":[{"id":"end_pathto01","ref":"end_thanks","title":"Thanks, that's really useful","bodyMd":"Your answers help us make the next person's decision easier.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_pathto01","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"compared"},"op":"eq","value":false}],"groups":[]},"from":"compared","target":"deciding_factors","targetKind":"block","branch":"true"}],"layout":{},"variables":[],"hiddenFields":[],"settings":{"language":"en","languages":[],"rtl":false,"progressBar":"percent","navigation":{"allowB