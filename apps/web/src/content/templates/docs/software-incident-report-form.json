 as I know","image_key":null},{"id":"opt_not_sure","label":"Not sure","image_key":null}],"allowOther":false},{"id":"blk_software11","ref":"impact","title":"What is it getting in the way of?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_signing_in","label":"Signing in","image_key":null},{"id":"opt_taking_payments_or","label":"Taking payments or orders","image_key":null},{"id":"opt_saving_or_loading","label":"Saving or loading data","image_key":null},{"id":"opt_sending_emails_or","label":"Sending emails or notifications","image_key":null},{"id":"opt_internal_work_only","label":"Internal work only","image_key":null}],"minSelections":0,"maxSelections":6,"allowOther":true},{"id":"blk_software12","ref":"tried","title":"What have you or anyone else already tried?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":800,"aiQualityCheck":false},{"id":"blk_software13","ref":"evidence","title":"Add a screenshot, recording or log file if you have one.","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"file_upload","accept":["image/*","video/*","text/plain","application/pdf"],"maxFiles":5,"maxSizeMB":25}],"endings":[{"id":"end_software01","ref":"end_thanks","title":"Incident logged 🛠️","bodyMd":"Thanks. The team has your report and will follow up by email. If it gets worse before then, report it again with the new details.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_software01","action_kind":"goto","when":{"op":"and","conditions":[],"groups":[]},"from":"callback_phone","target":"what_happened","targetKind":"block"},{"id":"rl_software02","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"severity"},"op":"eq","value":"opt_critical_it_s"}],"groups":[]},"from":"severity"