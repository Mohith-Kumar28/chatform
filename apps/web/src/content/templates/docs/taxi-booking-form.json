":"YYYY-MM-DD","includeTime":true,"timeStepMinutes":15,"timeMin":"00:00","timeMax":"23:45"},{"id":"blk_taxibook08","ref":"passengers","title":"How many passengers?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"number","unique":false,"min":1,"max":16,"integerOnly":true},{"id":"blk_taxibook09","ref":"luggage","title":"How much luggage?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_none_or_hand","label":"None or hand luggage only","image_key":null},{"id":"opt_one_or_two","label":"One or two suitcases","image_key":null},{"id":"opt_three_or_more","label":"Three or more suitcases","image_key":null},{"id":"opt_bulky_items_like","label":"Bulky items, like a bike or skis","image_key":null}],"allowOther":false},{"id":"blk_taxibook10","ref":"vehicle_needs","title":"Do you need any of these?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_wheelchair_accessible_vehi","label":"Wheelchair accessible vehicle","image_key":null},{"id":"opt_child_or_booster","label":"Child or booster seat","image_key":null},{"id":"opt_space_for_a","label":"Space for a pet","image_key":null},{"id":"opt_a_larger_car","label":"A larger car or van","image_key":null}],"minSelections":0,"maxSelections":5,"allowOther":false},{"id":"blk_taxibook11","ref":"return_trip","title":"Would you like to book a return trip too?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"yes_no","yesLabel":"Yes","noLabel":"No"},{"id":"blk_taxibook12","ref":"return_time","title":"When should we pick you up for the return?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"date","disablePast":true,"dateFormat":"YYYY-MM-DD","includeTime":true,"timeStepMinutes":15,"timeMin":"00:00","timeMax":"23:45"},{"id":"blk_taxibook13","ref":"pay_method","title":"