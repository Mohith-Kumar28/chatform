","label":"A short follow-up session","image_key":null},{"id":"opt_practice_with_a","label":"Practice with a colleague","image_key":null},{"id":"opt_time_with_the","label":"Time with the trainer","image_key":null},{"id":"opt_examples_from_our","label":"Examples from our own work","image_key":null}],"minSelections":0,"maxSelections":5,"allowOther":false},{"id":"blk_posttrai11","ref":"trainer","title":"How would you rate the trainer?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"rating","scale":5,"shape":"star"},{"id":"blk_posttrai12","ref":"checkin","title":"Would you like a quick check-in in a month to see how it's going?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"yes_no","yesLabel":"Yes","noLabel":"No"},{"id":"blk_posttrai13","ref":"checkin_email","title":"Which email should we use for that?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"email","unique":false,"businessOnly":false,"allowedDomains":[],"verify":false}],"endings":[{"id":"end_posttrai01","ref":"end_thanks","title":"Thank you, and good luck trying it out","bodyMd":"Your answers go to the training team to shape the next session.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]},{"id":"end_posttrai02","ref":"end_checkin","title":"We'll check in next month 📬","bodyMd":"Expect a short email in about four weeks asking how the first try went.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_posttrai01","action_kind":"goto","when":{"op":"and","conditions":[],"groups":[]},"from":"checkin_email","target":"end_checkin","targetKind":"ending"},{"id":"rl_posttrai02","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"relevance"},"op":"eq","value":"opt_almost_all_of"}],"groups":[]},"from":"relevance","target":"first_use","targetK