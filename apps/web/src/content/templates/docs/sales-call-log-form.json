ent","navigation":{"allowBack":true,"allowSkip":true},"closeRules":{"closedMessageMd":"This form is no longer accepting responses.","showCountdown":true,"showRemaining":false},"requireAuth":{"enabled":false,"method":"google","message":"Before we start, could you verify who you are? It only takes a moment.","afterBlocks":0},"password":{"enabled":false,"value":""},"captcha":{"enabled":true,"provider":"turnstile","mode":"adaptive"},"allowResubmissions":true,"onComplete":{"requireSubmit":true,"delaySec":4,"notificationEmails":[],"autoReplyEmail":{"enabled":true,"subject":"Thanks for your response","bodyMd":"Thanks for taking the time to fill in {{form.title}}. We've got your response, and this email is your copy of it.","includeAnswers":true}},"followUp":{"enabled":false,"channel":"email","steps":[{"delayHours":4,"subject":"You're {{remaining}} questions from finishing","bodyMd":"Everything you answered is saved, and picking up where you left off takes about a minute."},{"delayHours":24,"subject":"Your {{form.title}} is still open","bodyMd":"Just a nudge in case it slipped. Your answers are still here whenever you're ready."}],"showProgress":true,"holdoutPercent":0,"quietHours":true},"meta":{"ogImageKey":null,"faviconKey":null,"noIndex":false},"branding":{"hidePoweredBy":false},"embed":{"allowedOrigins":[]},"agent":{"mode":"hybrid","tone":"friendly","language":"en","rephraseQuestions":true,"guardrails":{"answerOffTopic":true,"refusalMessage":"I'm not sure about that one, but I can pass it on. Back to the form:","forbiddenTopics":[]},"maxClarificationsPerBlock":2,"escalateAfterInvalid":3,"responseMaxTokens":400}},"theme":{"colorScheme":"light","background":"#ece3ff","surface":"#ffffff","text":"#2a1f3d","accent":"#6d3fc7","accentText":"#fbf8ff","botBubble":"#ffffff","userBubble":"#6d3fc7","userBubbleText":"#ffffff","radius":"lg","fontHeading":"Bricolage Grotesque","fontBody":"Inter","avatarKey":null,"backgroundImageKey":null,"backgroundBrightness":1,"backgroundPattern":"r