item_price","label":"Price"},{"id":"opt_item_being_close","label":"Being close by"},{"id":"opt_item_atmosphere","label":"Atmosphere"},{"id":"opt_item_quick_service","label":"Quick service"},{"id":"opt_item_options_for","label":"Options for my diet"}]},{"id":"blk_restaura13","ref":"menu_wishes","title":"What would you like to see more of on the menu?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_vegetarian_and_vegan","label":"Vegetarian and vegan dishes","image_key":null},{"id":"opt_gluten_free_options","label":"Gluten-free options","image_key":null},{"id":"opt_seasonal_specials","label":"Seasonal specials","image_key":null},{"id":"opt_smaller_or_lighter","label":"Smaller or lighter plates","image_key":null},{"id":"opt_a_children_s","label":"A children's menu","image_key":null},{"id":"opt_non_alcoholic_drinks","label":"Non-alcoholic drinks","image_key":null}],"minSelections":1,"maxSelections":10,"allowOther":true},{"id":"blk_restaura14","ref":"next_visit","title":"What one thing would make your next visit better?","description":"A dish, a change to the room, the booking, anything at all.","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":600,"aiQualityCheck":false},{"id":"blk_restaura15","ref":"return_likely","title":"How likely are you to come back in the next few months?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"opinion_scale","steps":5,"startAt":1,"labelLow":"Not likely","labelHigh":"Definitely"}],"endings":[{"id":"end_restaura01","ref":"end_thanks","title":"Thank you, see you soon 🍽️","bodyMd":"Every response is read by the team, and your ideas go into our next menu planning.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_restaura01","action_kind":"goto","when":{"op":"and","c