olumns":[{"id":"opt_col_meets","label":"Meets"},{"id":"opt_col_partly_meets","label":"Partly meets"},{"id":"opt_col_does_not","label":"Does not meet"},{"id":"opt_col_not_checked","label":"Not checked"}],"multiplePerRow":false},{"id":"blk_qualitya06","ref":"result","title":"Overall result","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_passed","label":"Passed","image_key":null},{"id":"opt_passed_with_minor","label":"Passed with minor issues","image_key":null},{"id":"opt_failed","label":"Failed","image_key":null}],"allowOther":false},{"id":"blk_qualitya07","ref":"issues","title":"Describe what you found. Where was it, and what should it have been?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":2000,"aiQualityCheck":false},{"id":"blk_qualitya08","ref":"severity","title":"How serious is the worst issue?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_minor_cosmetic_no","label":"Minor: cosmetic, no effect on the customer","image_key":null},{"id":"opt_major_affects_the","label":"Major: affects the customer or needs rework","image_key":null},{"id":"opt_critical_safety_legal","label":"Critical: safety, legal or must not go out","image_key":null}],"allowOther":false},{"id":"blk_qualitya09","ref":"evidence","title":"Add photos, screenshots or files that show the issue","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"file_upload","accept":["image/*","application/pdf"],"maxFiles":5,"maxSizeMB":10},{"id":"blk_qualitya10","ref":"needs_action","title":"Does this need corrective action?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"yes_no","yesLabel":"Yes","noLabel":"No"},{"id":"blk_qualitya11","ref":"fix_owner","title":"Who should own the fix?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"short_text","unique":false,"minLength":0,"maxLength":80},{"id":"blk_qualitya12","ref":"fix_due","title":"When should it be fixed by?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"date","disablePast":true,"dateFormat":"YYYY-MM-DD","includeTime":false,"timeStepMinutes":30,"timeMin":"09:00","timeMax":"18:00"},{"id":"blk_qualitya13","ref":"process_notes","title":"Anything about the checklist or review process itself that needs attention?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1000,"aiQualityCheck":false}],"endings":[{"id":"end_qualitya01","ref":"end_thanks","title":"Review logged","bodyMd":"Thanks. It's saved with the others, and any corrective action is on record with its owner and date.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_qualitya01","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"result"},"op":"eq","value":"opt_passed"}],"groups":[]},"from":"result","target":"process_notes","targetKind":"block","branch":"true"},{"id":"rl_qualitya02","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"needs_action"},"op":"eq","value":false}],"groups":[]},"from":"needs_action","target":"process_notes","targetKind":"block","branch":"true"}],"layout":{},"variables":[],"hiddenFields":[],"settings":{"language":"en","languages":[],"rtl":false,"progressBar":"percent","navigation":{"allowBack":true,"allowSkip":true},"closeRules":{"closedMessageMd":"This form is no longer accepting responses.","showCountdown":true,"showRemaining":false},"requireAuth":{"enabled":false,"method":"google","message":"Before we start, could you verify who you are? It only takes a moment.","afterBlocks":0},"password":{"enabled":false,"value":""},"capt