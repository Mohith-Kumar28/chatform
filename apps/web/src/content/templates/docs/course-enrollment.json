":"success","requirements":[]},{"id":"end_courseen03","ref":"end_bursary","title":"Bursary application received 🎓","bodyMd":"The panel reviews applications regularly. We'll hold a place for you until they've decided.","imageUrl":null,"redirectDelaySec":4,"showSummary":false,"kind":"success","requirements":[]}],"endingRules":[],"logic":[{"id":"rl_courseen01","action_kind":"goto","when":{"op":"and","conditions":[],"groups":[]},"from":"why_this_level","target":"goal","targetKind":"block"},{"id":"rl_courseen02","action_kind":"goto","when":{"op":"and","conditions":[],"groups":[]},"from":"purchase_order","target":"end_invoice","targetKind":"ending"},{"id":"rl_courseen03","action_kind":"goto","when":{"op":"and","conditions":[],"groups":[]},"from":"bursary_reason","target":"end_bursary","targetKind":"ending"},{"id":"rl_courseen04","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"course"},"op":"eq","value":"opt_not_sure_help"}],"groups":[]},"from":"course","target":"experience","targetKind":"block","branch":"true"},{"id":"rl_courseen05","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"course"},"op":"eq","value":"opt_foundations"}],"groups":[]},"from":"course","target":"why_this_level","targetKind":"block","branch":"true"},{"id":"rl_courseen06","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"course"},"op":"eq","value":"opt_intermediate"}],"groups":[]},"from":"course","target":"why_this_level","targetKind":"block","branch":"true"},{"id":"rl_courseen07","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"course"},"op":"eq","value":"opt_advanced"}],"groups":[]},"from":"course","target":"why_this_level","targetKind":"block","branch":"true"},{"id":"rl_courseen08","action_kind":"goto","when":{"op":"and","conditions":[{"left":{"kind":"ref","ref":"funding"},"op":"eq","value":"opt_myself"}],"groups":[]},"from":"funding","target":"end_thanks","targetKind