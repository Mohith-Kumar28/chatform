y new clothes or accessories?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"single_select","options":[{"id":"opt_every_week_or","label":"Every week or two","image_key":null},{"id":"opt_about_once_a","label":"About once a month","image_key":null},{"id":"opt_a_few_times","label":"A few times a year","image_key":null},{"id":"opt_only_when_i","label":"Only when I need something","image_key":null}],"allowOther":false},{"id":"blk_fashionm07","ref":"factors","title":"Rank what matters most when you decide to buy.","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"ranking","items":[{"id":"opt_item_price","label":"Price"},{"id":"opt_item_fit","label":"Fit"},{"id":"opt_item_quality_and","label":"Quality and fabric"},{"id":"opt_item_how_it","label":"How it's made"},{"id":"opt_item_the_brand","label":"The brand"},{"id":"opt_item_being_on","label":"Being on trend"}]},{"id":"blk_fashionm08","ref":"sustainability","title":"How much does how a piece was made affect your choice?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"opinion_scale","steps":5,"startAt":1,"labelLow":"Not at all","labelHigh":"It decides it"},{"id":"blk_fashionm09","ref":"discovery","title":"Where do you usually discover new brands?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_instagram_or_tiktok","label":"Instagram or TikTok","image_key":null},{"id":"opt_friends_and_family","label":"Friends and family","image_key":null},{"id":"opt_online_marketplaces","label":"Online marketplaces","image_key":null},{"id":"opt_fashion_magazines_or","label":"Fashion magazines or blogs","image_key":null},{"id":"opt_walking_past_a","label":"Walking past a store","image_key":null},{"id":"opt_search_engines","label":"Search engines","image_key":null}],"minSelections":1,"maxSelections":4,"allowOther":true},{"id":"blk_fashionm10