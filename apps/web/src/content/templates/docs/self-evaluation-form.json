_key":null},{"id":"opt_met_most","label":"Met most","image_key":null},{"id":"opt_met_some","label":"Met some","image_key":null},{"id":"opt_met_few_or","label":"Met few or none","image_key":null}],"allowOther":false},{"id":"blk_selfeval06","ref":"goals_blockers","title":"What got in the way of the ones you missed?","description":"Priorities changing, resources, skills, anything. This is not about blame.","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1000,"aiQualityCheck":false},{"id":"blk_selfeval07","ref":"self_rating","title":"How would you rate yourself on each of these?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"matrix","rows":[{"id":"opt_row_quality_of","label":"Quality of work"},{"id":"opt_row_communication","label":"Communication"},{"id":"opt_row_working_with","label":"Working with others"},{"id":"opt_row_ownership_and","label":"Ownership and follow-through"},{"id":"opt_row_learning_new","label":"Learning new skills"}],"columns":[{"id":"opt_col_needs_work","label":"Needs work"},{"id":"opt_col_solid","label":"Solid"},{"id":"opt_col_a_real","label":"A real strength"}],"multiplePerRow":false},{"id":"blk_selfeval08","ref":"challenge","title":"Describe a challenge you faced and how you handled it.","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1500,"aiQualityCheck":false},{"id":"blk_selfeval09","ref":"workload","title":"How manageable has your workload been?","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"opinion_scale","steps":5,"startAt":1,"labelLow":"Unsustainable","labelHigh":"Very manageable"},{"id":"blk_selfeval10","ref":"workload_detail","title":"What's making it hard to manage?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":800,"aiQualityCheck":false},{"id":"blk_selfeval11","ref":"growth","title":"Where do you most want to grow next? Pick up to three.","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"multi_select","options":[{"id":"opt_technical_or_craft","label":"Technical or craft skills","image_key":null},{"id":"opt_leading_people","label":"Leading people","image_key":null},{"id":"opt_communication_and_presenti","label":"Communication and presenting","image_key":null},{"id":"opt_planning_and_prioritising","label":"Planning and prioritising","image_key":null},{"id":"opt_strategic_thinking","label":"Strategic thinking","image_key":null},{"id":"opt_knowledge_of_the","label":"Knowledge of the wider business","image_key":null}],"minSelections":1,"maxSelections":3,"allowOther":true},{"id":"blk_selfeval12","ref":"next_goals","title":"What do you want to achieve next period?","description":"Two or three goals in your own words. You'll agree the final version with your manager.","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1000,"aiQualityCheck":false},{"id":"blk_selfeval13","ref":"support","title":"What support would help you most next period?","description":"From your manager, the team, training, tools or time.","required":true,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1000,"aiQualityCheck":false},{"id":"blk_selfeval14","ref":"raise","title":"Anything else you want to raise in the review conversation?","required":false,"visibility":null,"image_key":null,"agentHints":null,"media":null,"type":"long_text","minLength":0,"maxLength":1000,"aiQualityCheck":false}],"endings":[{"id":"end_selfeval01","ref":"end_thanks","title":"Thanks for taking the time","bodyMd":"Your manager will read this before your review, so you can spend the conversation on what matters.","imageUrl":null,"redirectDelaySec":4,"showSummary":f